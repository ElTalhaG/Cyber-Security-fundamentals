# SAMPLE MAC ONLY: 02:00:00:00:01:12 belongs to the isolated demo.
# Regenerate using the real Windows VM MAC before applying to the course gateway.
# Generated IPv4 lab filter table; replaces existing filter rules.
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate INVALID -j DROP
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -m conntrack --ctstate INVALID -j DROP
-A FORWARD -i eth0 ! -s 192.168.1.0/24 -j DROP
-A FORWARD -i eth1 ! -s 192.168.2.0/24 -j DROP
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -i eth1 -o eth0 -s 192.168.2.0/24 -d 192.168.1.0/24 -m conntrack --ctstate NEW -j ACCEPT
-A FORWARD -i eth0 -o eth1 -s 192.168.1.12 -d 192.168.2.10 -p tcp --syn --dport 23 -m mac --mac-source 02:00:00:00:01:12 -m conntrack --ctstate NEW -j ACCEPT
COMMIT
